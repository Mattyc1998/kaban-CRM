generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Runtime settings (DB-backed, not .env) ----------

// Small key/value store for settings editable from the UI at runtime —
// e.g. Telegram bot token/chat ID. Vercel's production filesystem is
// read-only, so these can't be written to .env like local dev; the DB is
// the one place that works in both environments.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------- Auth ----------

enum UserRole {
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
}

// Portal login for customers — built later, schema exists now.
model Customer {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  company      String?
  createdAt    DateTime  @default(now())
  projects     Project[]
}

// ---------- Lead CRM Kanban ----------

enum LeadStage {
  INTERESTED
  RESEARCH
  READY_TO_CALL
  CALL_BOOKED
  CALL_TAKEN_PLACE
  DECISION_MAKER
  WON
  LOST
}

enum LeadSource {
  MANUAL
  N8N
  INSTANTLY
}

enum AiResearchStatus {
  NONE
  PENDING
  RUNNING
  DONE
  FAILED
}

model Lead {
  id     String @id @default(cuid())
  name   String
  company String?
  email  String?
  phone  String?

  companyId     String?
  linkedCompany Company? @relation(fields: [companyId], references: [id])

  stage    LeadStage  @default(INTERESTED)
  source   LeadSource @default(MANUAL)
  // Fractional index within a column (Trello-style) so reordering never
  // needs to rewrite sibling rows.
  position Float      @default(0)

  // Estimated deal value in whole dollars, for the pipeline value stat.
  dealValue Int?

  // dedupe key for webhook-created leads (n8n/Instantly record id)
  externalId String?

  aiSummary        String?
  aiPainPoints      String?
  aiCallAngle       String?
  aiResearchStatus  AiResearchStatus @default(NONE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities LeadActivity[]
  projects   Project[]

  @@index([stage, position])
  @@index([source, externalId])
  @@index([companyId])
}

enum LeadActivityType {
  REPLY
  NOTE
  STAGE_CHANGE
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      LeadActivityType
  content   String
  createdAt DateTime         @default(now())

  @@index([leadId])
}

// ---------- Project tracking ----------

enum RetainerInterval {
  MONTHLY
  YEARLY
}

enum ProjectStage {
  ONBOARDING
  PLANNING
  BUILDING
  REVIEW
  CHANGES
  COMPLETED
}

model Project {
  id         String       @id @default(cuid())
  leadId     String?
  lead       Lead?        @relation(fields: [leadId], references: [id])
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id])
  companyId  String?
  company    Company?     @relation(fields: [companyId], references: [id])
  name       String
  stage      ProjectStage @default(ONBOARDING)

  clientName    String?
  clientCompany String?
  clientEmail   String?
  budget        Int?
  // Overall completion, 0-100. Admin-adjustable, not derived from task
  // ratio — a project can be "90% done" while only 2/5 tasks are checked
  // off if the remaining tasks are small.
  progress    Int      @default(0)
  // Unguessable slug backing the public /portal/[slug] page. Acts as the
  // access control until real Customer login (a later phase) exists.
  portalSlug  String   @unique
  // Fractional index within a stage column, same pattern as Lead.position.
  position    Float    @default(0)
  // Optional staging/live URL the client can open from the portal to watch
  // progress in real time (e.g. a Vercel preview deployment).
  previewUrl  String?

  // Ongoing hosting/maintenance billing after the one-off project budget —
  // separate from `budget` since they're different kinds of money (a
  // one-off spend vs. a recurring rate) and shouldn't be summed together.
  retainerAmount   Int?
  retainerActive   Boolean          @default(false)
  // Some clients pay annually instead of monthly — MRR roll-ups normalize
  // a YEARLY amount to its monthly equivalent (amount / 12) rather than
  // assuming every retainer bills the same way.
  retainerInterval RetainerInterval @default(MONTHLY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks           ProjectTask[]
  files           ProjectFile[]
  comments        ProjectComment[]
  changeRequests  ProjectChangeRequest[]
  milestones      ProjectMilestone[]
  proposals       Proposal[]

  @@index([companyId])
}

// ---------- Companies & contacts ----------

// The business/client — holds the money (projects, retainers), the pipeline
// (leads), and the communication history. What used to be the flat
// "Contact" model before it needed to support multiple people per business.
model Company {
  id        String   @id @default(cuid())
  name      String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts  Contact[]
  projects  Project[]
  leads     Lead[]
  proposals Proposal[]
  emailLogs EmailLog[]

  @@index([name])
}

// An individual person at a Company — multiple per company (e.g. an owner
// and a manager). Just contact details; money/projects live on Company.
model Contact {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  role      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([email])
}

// ---------- Email log ----------

enum EmailDirection {
  SENT
  RECEIVED
}

// Manual log of email touchpoints that happen outside the portal (e.g. in
// Outlook) — not a real inbox sync (that needs OAuth against Microsoft
// Graph, a whole separate setup on the user's end), just a quick record so
// a company's full communication history lives in one place.
model EmailLog {
  id          String         @id @default(cuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  direction   EmailDirection
  subject     String
  summary     String
  contactedAt DateTime       @default(now())
  createdAt   DateTime       @default(now())

  attachments EmailAttachment[]

  @@index([companyId])
}

model EmailAttachment {
  id         String   @id @default(cuid())
  emailLogId String
  emailLog   EmailLog @relation(fields: [emailLogId], references: [id], onDelete: Cascade)
  url        String
  name       String
  createdAt  DateTime @default(now())

  @@index([emailLogId])
}

// ---------- Proposals & e-signature ----------

enum ProposalStatus {
  DRAFT
  SENT
  SIGNED
  DECLINED
}

model Proposal {
  id        String    @id @default(cuid())
  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id])
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id])

  title         String
  clientName    String?
  clientCompany String?
  clientEmail   String?
  // Scope of work — plain text, rendered with line breaks preserved on the
  // public page. Not rich text; this is a one-person shop, not a document
  // editor product.
  scope         String
  price         Int?

  // What the client needs to hand over before/during the work (assets,
  // logins, copy) and how payment is structured — the two things clients
  // most often ask about after reading the scope. Both optional free text
  // since exact terms vary per deal.
  clientProvides String?
  paymentTerms   String?
  // Date this quote stops being honored (e.g. pricing may change after).
  // Optional — proposals without one just don't show an expiry.
  validUntil     DateTime?

  status     ProposalStatus @default(DRAFT)
  // Unguessable slug backing the public /proposal/[slug] page — same
  // access-control model as Project.portalSlug.
  publicSlug String         @unique

  // Typed-name e-signature: legally sufficient for this use case and far
  // simpler than a signature-pad/canvas, which this doesn't need.
  signedName String?
  signedAt   DateTime?
  signedIp   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([projectId])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model ProjectTask {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean      @default(false)
  priority  TaskPriority @default(MEDIUM)
  dueAt     DateTime?
  createdAt DateTime     @default(now())

  @@index([projectId])
}

enum ProjectFileKind {
  DELIVERABLE
  MEDIA
}

enum DeliverableStatus {
  PENDING
  APPROVED
}

model ProjectFile {
  id         String            @id @default(cuid())
  projectId  String
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind       ProjectFileKind   @default(DELIVERABLE)
  // Meaningful for DELIVERABLE files (client sign-off); ignored for MEDIA.
  status     DeliverableStatus @default(PENDING)
  url        String
  name       String
  // "admin" or the name the client typed on the portal upload form.
  uploadedBy String            @default("admin")
  createdAt  DateTime          @default(now())

  @@index([projectId])
}

model ProjectMilestone {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  dueAt     DateTime?
  completed Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([projectId])
}

model ProjectComment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    String
  content   String
  createdAt DateTime @default(now())

  @@index([projectId])
}

enum ChangeRequestStatus {
  PENDING
  RESOLVED
}

model ProjectChangeRequest {
  id        String               @id @default(cuid())
  projectId String
  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content   String
  status    ChangeRequestStatus  @default(PENDING)
  createdAt DateTime             @default(now())

  @@index([projectId])
}

// ---------- Kaban Copilot ----------

enum CopilotChannel {
  WEB
  TELEGRAM
}

enum CopilotRole {
  USER
  ASSISTANT
}

model CopilotMessage {
  id        String         @id @default(cuid())
  channel   CopilotChannel
  role      CopilotRole
  content   String
  createdAt DateTime       @default(now())

  @@index([createdAt])
}

// ---------- Call Queue (cold-calling cadence tracker) ----------

enum CallQueueStatus {
  ACTIVE
  COMPLETE
}

model CallQueueLead {
  id           String          @id @default(cuid())
  leadName     String
  company      String?
  phone        String?
  email        String?
  // Cadence step: 1, 3, 5, 7 — advances via markCalled, see
  // lib/actions/call-queue.ts.
  sequenceDay  Int             @default(1)
  nextCallDate DateTime
  status       CallQueueStatus @default(ACTIVE)
  source       String?
  // Context pulled from a Google Maps / Places-style export (place_id,
  // address, website, rating, reviews) — useful to have on hand before
  // calling, even though nothing here drives cadence logic.
  placeId      String?
  address      String?
  website      String?
  rating       Float?
  reviews      Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status, nextCallDate])
}
