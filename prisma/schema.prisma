generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Runtime settings (DB-backed, not .env) ----------

// Small key/value store for settings editable from the UI at runtime —
// e.g. Telegram bot token/chat ID. Vercel's production filesystem is
// read-only, so these can't be written to .env like local dev; the DB is
// the one place that works in both environments.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------- Auth ----------

enum UserRole {
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
}

// Portal login for customers — built later, schema exists now.
model Customer {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  company      String?
  createdAt    DateTime  @default(now())
  projects     Project[]
}

// ---------- Lead CRM Kanban ----------

enum LeadStage {
  INTERESTED
  RESEARCH
  READY_TO_CALL
  CALL_BOOKED
  WON
  LOST
}

enum LeadSource {
  MANUAL
  N8N
  INSTANTLY
}

enum AiResearchStatus {
  NONE
  PENDING
  RUNNING
  DONE
  FAILED
}

model Lead {
  id     String @id @default(cuid())
  name   String
  company String?
  email  String?
  phone  String?

  stage    LeadStage  @default(INTERESTED)
  source   LeadSource @default(MANUAL)
  // Fractional index within a column (Trello-style) so reordering never
  // needs to rewrite sibling rows.
  position Float      @default(0)

  // Estimated deal value in whole dollars, for the pipeline value stat.
  dealValue Int?

  // dedupe key for webhook-created leads (n8n/Instantly record id)
  externalId String?

  aiSummary        String?
  aiPainPoints      String?
  aiCallAngle       String?
  aiResearchStatus  AiResearchStatus @default(NONE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities LeadActivity[]
  projects   Project[]

  @@index([stage, position])
  @@index([source, externalId])
}

enum LeadActivityType {
  REPLY
  NOTE
  STAGE_CHANGE
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      LeadActivityType
  content   String
  createdAt DateTime         @default(now())

  @@index([leadId])
}

// ---------- Project tracking ----------

enum ProjectStage {
  ONBOARDING
  PLANNING
  BUILDING
  REVIEW
  CHANGES
  COMPLETED
}

model Project {
  id         String       @id @default(cuid())
  leadId     String?
  lead       Lead?        @relation(fields: [leadId], references: [id])
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id])
  name       String
  stage      ProjectStage @default(ONBOARDING)

  clientName    String?
  clientCompany String?
  clientEmail   String?
  budget        Int?
  // Overall completion, 0-100. Admin-adjustable, not derived from task
  // ratio — a project can be "90% done" while only 2/5 tasks are checked
  // off if the remaining tasks are small.
  progress    Int      @default(0)
  // Unguessable slug backing the public /portal/[slug] page. Acts as the
  // access control until real Customer login (a later phase) exists.
  portalSlug  String   @unique
  // Fractional index within a stage column, same pattern as Lead.position.
  position    Float    @default(0)
  // Optional staging/live URL the client can open from the portal to watch
  // progress in real time (e.g. a Vercel preview deployment).
  previewUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks           ProjectTask[]
  files           ProjectFile[]
  comments        ProjectComment[]
  changeRequests  ProjectChangeRequest[]
  milestones      ProjectMilestone[]
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model ProjectTask {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean      @default(false)
  priority  TaskPriority @default(MEDIUM)
  dueAt     DateTime?
  createdAt DateTime     @default(now())

  @@index([projectId])
}

enum ProjectFileKind {
  DELIVERABLE
  MEDIA
}

enum DeliverableStatus {
  PENDING
  APPROVED
}

model ProjectFile {
  id         String            @id @default(cuid())
  projectId  String
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind       ProjectFileKind   @default(DELIVERABLE)
  // Meaningful for DELIVERABLE files (client sign-off); ignored for MEDIA.
  status     DeliverableStatus @default(PENDING)
  url        String
  name       String
  // "admin" or the name the client typed on the portal upload form.
  uploadedBy String            @default("admin")
  createdAt  DateTime          @default(now())

  @@index([projectId])
}

model ProjectMilestone {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  dueAt     DateTime?
  completed Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([projectId])
}

model ProjectComment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    String
  content   String
  createdAt DateTime @default(now())

  @@index([projectId])
}

enum ChangeRequestStatus {
  PENDING
  RESOLVED
}

model ProjectChangeRequest {
  id        String               @id @default(cuid())
  projectId String
  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content   String
  status    ChangeRequestStatus  @default(PENDING)
  createdAt DateTime             @default(now())

  @@index([projectId])
}

// ---------- Kaban Copilot ----------

enum CopilotChannel {
  WEB
  TELEGRAM
}

enum CopilotRole {
  USER
  ASSISTANT
}

model CopilotMessage {
  id        String         @id @default(cuid())
  channel   CopilotChannel
  role      CopilotRole
  content   String
  createdAt DateTime       @default(now())

  @@index([createdAt])
}
