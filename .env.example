# Postgres (matches docker-compose.yml, container "kaban-crm-db")
DATABASE_URL="postgresql://kaban:kaban_dev_password@localhost:5433/kaban_crm"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"

# Seed script — creates the first admin user (npx prisma db seed)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Admin"

# Webhook shared secrets (sent as header: x-webhook-secret)
N8N_WEBHOOK_SECRET="change-me-n8n"
INSTANTLY_WEBHOOK_SECRET="change-me-instantly"

# Optional — leave unset to keep integrations stubbed/logged only
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
AI_RESEARCH_API_KEY=""

# Kaban Copilot (xAI Grok) — get a key at https://console.x.ai
XAI_API_KEY=""
